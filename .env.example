# REVA NEXUS V11 PRODUCTION
NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://reva:CHANGE_ME@localhost:5432/reva_nexus
SESSION_SECRET=GENERATE_A_LONG_RANDOM_SECRET
ADMIN_SEED_EMAIL=owner@example.com
ADMIN_SEED_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# S3-compatible object storage (Cloudflare R2, AWS S3, Backblaze B2 S3 API, etc.)
S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=reva-nexus-media
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_PUBLIC_BASE_URL=https://cdn.example.com
